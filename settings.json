{
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 40960,
    "modelOverrides": {
      "deepseek/deepseek-flash": {
        "reserveTokens": 300000
      }
    }
  },
  "defaultModel": "deepseek-flash",
  "defaultProvider": "deepseek",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "read",
    "write",
    "edit",
    "ls",
    "grep",
    "find",
    "bash"
  ],
  "fullscreenExitOutput": "transcript",
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.99.2",
  "markdown": {
    "mermaid": "final"
  },
  "packages": [
    "npm:pi-open-tui",
    "npm:pi-tool-display",
    "npm:@gotgenes/pi-permission-system",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/netcatty/pi-models-sync",
    "git:github.com/netcatty/pi-subtasks",
    "git:github.com/netcatty/pi-tools",
    "npm:@wayner6/pi-usage",
    "npm:pi-extension-watchdog"
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 10000,
    "enabled": true,
    "maxRetries": 10,
    "provider": {
      "maxRetryDelayMs": 120000
    }
  },
  "showCacheMissNotices": false,
  "theme": "noctalia",
  "transport": "auto",
  "treeFilterMode": "no-tools",
  "tuiMode": "fullscreen"
}