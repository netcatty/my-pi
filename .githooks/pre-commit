#!/bin/sh
# ─────────────────────────────────────────────────────────────
#  pre-commit：拦截密钥、内部地址与机器特定路径
#
#  安装：git config core.hooksPath .githooks
#  绕过：git commit --no-verify
#
#  注意：所有 grep 模式都用 -e 显式传入。模式以 - 开头时
#        不加 -e 会被 grep 当成选项，直接报错导致检查静默失效。
# ─────────────────────────────────────────────────────────────

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

FAIL=0
report() {
  FAIL=1
  printf '  ✗ %s\n' "$1"
  printf '      %s\n' "$2"
}

printf '\n🔍 pre-commit 审计\n\n'

# ── 1. 敏感文件名 ──
for f in $STAGED; do
  case "$f" in
    auth.json|*/auth.json)
      report "$f" "凭据文件，禁止提交" ;;
    models.json|*/models.json)
      report "$f" "含内部地址；请改用 models.example.json" ;;
    mcp.json|*/mcp.json)
      report "$f" "含本地服务令牌；请改用 mcp.example.json" ;;
    *.env|*.env.*|*.pem|*.key)
      report "$f" "疑似密钥文件" ;;
    *.example.json)
      : ;;   # 模板文件放行
    models-store.json|trust.json)
      report "$f" "机器本地状态" ;;
    *.bak|*.bak-*)
      report "$f" "备份文件" ;;
  esac
done

# ── 2. 内容扫描 ──
for f in $STAGED; do
  [ -f "$f" ] || continue

  # 2a. API key / token 特征
  HIT=$(grep -nE -e 'sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}' "$f" 2>/dev/null | head -3)
  [ -n "$HIT" ] && report "$f" "API key: $(echo "$HIT" | head -1 | cut -c1-80)"

  # 2b. 32+ 位十六进制串（排除占位符行）
  HIT=$(grep -nE -e '[a-f0-9]{32,}' "$f" 2>/dev/null \
        | grep -vE -e '\$\{|\$[A-Z_]+|example\.com|schema|sha256|integrity' | head -3)
  [ -n "$HIT" ] && report "$f" "长十六进制串: $(echo "$HIT" | head -1 | cut -c1-80)"

  # 2c. 私钥 —— 要求 BEGIN 之后 3 行内出现 base64 主体。
  #     否则把 `-----BEGIN ... PRIVATE KEY-----` 当正则模式写的源码会被误报
  #     （本仓的 filter-output 扩展就这么被拦下过一次）。
  #     也兼容 Proc-Type 头在前、主体不在第二行的加密 PEM。
  HIT=$(grep -nA3 -E -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' "$f" 2>/dev/null \
        | grep -E -e '^[0-9]+-[A-Za-z0-9+/=]{40,}' | head -2)
  [ -n "$HIT" ] && report "$f" "私钥块"

  # 2d. token/secret 赋值（值为 12+ 字符的字面量；排除占位符）
  HIT=$(grep -nEi -e '(token|secret|password|passwd|api[_-]?key)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{12,}["'"'"']' "$f" 2>/dev/null \
        | grep -vE -e '\$\{|\$[A-Z_]+|example\.com|your-|placeholder|xxxx|\.\.\.|<[a-z]' | head -3)
  [ -n "$HIT" ] && report "$f" "明文赋值: $(echo "$HIT" | head -1 | cut -c1-80)"

  # 2e. 非公开域名（白名单之外）
  HIT=$(grep -noE -e 'https?://[A-Za-z0-9._-]+' "$f" 2>/dev/null \
        | sed 's|.*https\?://||' \
        | sort -u \
        | grep -viE -e '^(github\.com|api\.github\.com|raw\.githubusercontent\.com|api\.deepseek\.com|pi\.dev|linux\.do|json-schema\.org|agentskills\.io|localhost|127\.0\.0\.1|docs\.python\.org|en\.wikipedia\.org|www\.conventionalcommits\.org|fonts\.googleapis\.com|fonts\.gstatic\.com|cdn\.sheetjs\.com|www\.apache\.org|schemas\.microsoft\.com|manus\.im|skills\.sh|example\.com)$' \
        | grep -viE -e '\.example\.com$' | head -3)
  [ -n "$HIT" ] && report "$f" "非白名单域名: $(echo "$HIT" | tr '\n' ' ' | cut -c1-80)"

  # 2f. 机器特定路径 —— 只查 .md（文档不该出现本机目录结构）
  #     模式要求 `盘符:\` 后紧跟路径字符，避开 `Status:\*\*` 这类正则转义
  case "$f" in
    *.md)
      HIT=$(grep -nE -e '[A-Za-z]:\\[A-Za-z0-9_.]' "$f" 2>/dev/null | head -3)
      [ -n "$HIT" ] && report "$f" "文档里的机器特定路径: $(echo "$HIT" | head -1 | cut -c1-70)"
      ;;
  esac
done

# ── 结果 ──
if [ "$FAIL" -eq 0 ]; then
  printf '✅ 审计通过\n\n'
  exit 0
fi

printf '\n⛔ 提交已拦截。修正后重试，或 git commit --no-verify 强制提交。\n\n'
exit 1
